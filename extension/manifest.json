{
  "manifest_version": 3,
  "name": "Moth70 Bug Reporter",
  "version": "1.0",
  "description": "Report bugs directly from your browser",
  "permissions": [
    "activeTab",
    "scripting",
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Report a Bug"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js", "vendor/rrweb.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
